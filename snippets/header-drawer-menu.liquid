{% comment %}
  Mobile menu drawer contents. Not rendered with the page: sections/header-drawer-menu.liquid
  serves it and HeaderDrawer (assets/global.js) fetches it on the first tap of the menu button.
  Two levels: groups open a submenu of links (a third menu level shows as plain links).

  Accepts:
  - menu: {Object} Link list for the main navigation
{% endcomment %}
<div class="menu-drawer__inner-container">
  <div class="menu-drawer__panels">
    <div class="menu-drawer__navigation-container">
      <nav class="menu-drawer__navigation">
        <ul class="menu-drawer__menu has-submenu list-menu" role="list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links != blank -%}
                <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                  <summary
                    id="HeaderDrawer-{{ link.handle }}"
                    class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active or link.current %} menu-drawer__menu-item--active{% endif %}"
                  >
                    {{ link.title | escape }}
                    <span class="svg-wrapper">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  </summary>
                  <div
                    id="link-{{ link.handle | escape }}"
                    class="menu-drawer__submenu has-submenu motion-reduce"
                    tabindex="-1"
                  >
                    <div class="menu-drawer__inner-submenu">
                      <button class="menu-drawer__close-button link focus-inset" aria-expanded="true">
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        {{ 'sections.header.all_sections' | t }}
                      </button>
                      <p class="menu-drawer__submenu-title">{{ link.title | escape }}</p>
                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                        {%- # Only when the group has a page of its own; most groups link to one of their own items -%}
                        {%- assign child_urls = link.links | map: 'url' -%}
                        {%- unless child_urls contains link.url -%}
                        <li>
                          <a
                            href="{{ link.url }}"
                            class="menu-drawer__menu-item menu-drawer__menu-item--all link list-menu__item focus-inset"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ 'sections.header.view_all_in' | t: title: link.title }}
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                          </a>
                        </li>
                        {%- endunless -%}
                        {%- for childlink in link.links -%}
                          <li>
                            <a
                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ childlink.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a
                  id="HeaderDrawer-{{ link.handle }}"
                  href="{{ link.url }}"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="menu-drawer__utility-links">
        {%- if linklists['secondary-menu'].links != blank -%}
          <ul class="list-unstyled" role="list">
            {%- for link in linklists['secondary-menu'].links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="menu-drawer__service-link link focus-inset"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if localization.available_languages.size > 1 -%}
          {%- liquid
            # The same page in each language: swap the current locale prefix for the target one.
            assign page_path = request.path
            if localization.language.root_url != '/'
              assign page_path = request.path | remove_first: localization.language.root_url
            endif
          -%}
          <ul class="menu-drawer__languages list-unstyled" role="list" aria-label="{{ 'localization.language_label' | t }}">
            {%- for language in localization.available_languages -%}
              {%- assign language_url = language.root_url | append: page_path | replace: '//', '/' -%}
              <li>
                <a
                  href="{{ language_url }}"
                  class="menu-drawer__language focus-inset"
                  hreflang="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  title="{{ language.endonym_name | capitalize }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- language.endonym_name | slice: 0, 3 | upcase -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if shop.phone != blank -%}
    <div class="menu-drawer__call-bar">
      <a href="tel:{% render 'phone-number', format: 'href' %}" class="ui-btn ui-btn--primary menu-drawer__call">
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-phone.svg' | inline_asset_content -}}
        </span>
        {{ 'sections.header.call' | t }} &middot; {% render 'phone-number', format: 'display' %}
      </a>
    </div>
  {%- endif -%}
</div>
