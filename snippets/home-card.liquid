{%- comment -%}
  Homepage product card (C2 draft): image, title, review stars, price (+ old price) with a Buy button, in-stock line.
  Buy adds single-variant products to the cart drawer (Dawn product-form); other products link to the product page.
  Sold-out products show «Продано» instead of the price (never "0 ₴") and a Details link instead of Buy.
  Styles live in assets/home-sections.css.

  Accepts:
  - product: {Object} Product Liquid object
  - section_id: {String} ID of the section that renders the card
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'HomeCard-' | append: section_id | append: '-' | append: product.id
  assign quick_buy = false
  if product.available and product.has_only_default_variant and variant.quantity_rule.min <= 1 and variant.quantity_rule.increment <= 1
    assign quick_buy = true
  endif
-%}
<div class="home-card">
  <a class="home-card__image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 533
        | image_tag: widths: '165, 330, 533', sizes: '(min-width: 990px) 280px, (min-width: 750px) 30vw, 45vw', loading: 'lazy', alt: ''
      }}
    {%- endif -%}
  </a>
  <a class="home-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
  {% render 'review-badge', product: product %}
  <div class="home-card__row">
    {%- if product.available -%}
      {%- comment -%} The shop's money format has no symbol; append it like snippets/price.liquid {%- endcomment -%}
      {%- capture price -%}{{ product.price | money_without_currency }}&nbsp;{{ cart.currency.symbol }}{%- endcapture -%}
      <span class="home-card__price">
        {%- if product.price_varies -%}
          {{ 'products.product.price.from_price_html' | t: price: price }}
        {%- else -%}
          {{ price }}
        {%- endif -%}
        {%- if variant.compare_at_price > variant.price and product.price_varies == false -%}
          <s class="home-card__old">
            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
            {{- variant.compare_at_price | money_without_currency }}&nbsp;{{ cart.currency.symbol -}}
          </s>
        {%- endif -%}
      </span>
    {%- else -%}
      <span class="home-card__sold">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
    {%- if quick_buy -%}
      <product-form data-section-id="{{ section_id }}" data-hide-errors="true">
        {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" name="add" class="home-btn home-btn--buy home-card__buy">
            <span>{{ 'products.product.buy' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- elsif product.available -%}
      <a class="home-btn home-btn--buy home-card__buy" href="{{ product.url }}">{{ 'products.product.buy' | t }}</a>
    {%- else -%}
      <a class="home-btn home-btn--ghost home-card__buy" href="{{ product.url }}">
        {{- 'products.product.details' | t -}}
      </a>
    {%- endif -%}
  </div>
  {%- if product.available -%}
    <p class="home-card__stock">{{ 'products.product.inventory_in_stock' | t }}</p>
  {%- endif -%}
</div>
