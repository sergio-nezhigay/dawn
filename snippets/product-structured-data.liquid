{% comment %}
  Renders Product JSON-LD via Shopify's built-in structured_data filter, splicing in
  aggregateRating from the reviews.rating / reviews.rating_count metafields when present
  (the built-in filter does not emit aggregateRating on its own).

  Also patches merchant-listing fields the filter gets wrong or omits:
  - barcode holds the manufacturer part number on most products, which the filter emits
    as "gtin" (Google: "Invalid GTIN"). Alphanumeric barcodes become "mpn"; short numeric
    internal codes are dropped; valid 8/12/13/14-digit barcodes stay "gtin".
  - every Offer gets shippingDetails (UA, 1-2 days) and hasMerchantReturnPolicy (14 days).

  Products with every variant priced 0 (legacy sold-out items) get no Product markup:
  a 0 price reads as "free", and Product markup without an offer is flagged by Google.

  Accepts:
  - product: {Object} Product Liquid object (required)
{% endcomment %}
{%- liquid
  assign structured_data_json = product | structured_data | strip
  for variant in product.variants
    assign barcode = variant.barcode | strip
    if barcode == blank
      continue
    endif
    assign non_digits = barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    assign barcode_json = variant.barcode | json
    assign gtin_pair = '"gtin":' | append: barcode_json
    if non_digits == blank
      unless barcode.size == 8 or barcode.size == 12 or barcode.size == 13 or barcode.size == 14
        # Short numeric codes are internal store codes, not GTINs or manufacturer MPNs: drop.
        # The built-in filter emits these as either "gtin" or "mpn" depending on the code.
        assign gtin_pair_comma = gtin_pair | append: ','
        assign mpn_pair_comma = '"mpn":' | append: barcode_json | append: ','
        assign structured_data_json = structured_data_json | remove: gtin_pair_comma | remove: mpn_pair_comma
      endunless
    else
      assign mpn_pair = '"mpn":' | append: barcode_json
      assign structured_data_json = structured_data_json | replace: gtin_pair, mpn_pair
    endif
  endfor

  capture offer_extras
    echo '"@type":"Offer",'
    echo '"shippingDetails":{"@type":"OfferShippingDetails",'
    echo '"shippingDestination":{"@type":"DefinedRegion","addressCountry":"UA"},'
    echo '"deliveryTime":{"@type":"ShippingDeliveryTime",'
    echo '"handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":1,"unitCode":"DAY"},'
    echo '"transitTime":{"@type":"QuantitativeValue","minValue":1,"maxValue":1,"unitCode":"DAY"}}},'
    echo '"hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"UA",'
    echo '"returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow",'
    echo '"merchantReturnDays":14,"returnMethod":"https://schema.org/ReturnByMail"},'
  endcapture
  assign structured_data_json = structured_data_json | replace: '"@type":"Offer",', offer_extras

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count

  if rating != blank and rating_count > 0
    assign json_length = structured_data_json.size
    assign closing_index = json_length | minus: 1
    assign structured_data_json = structured_data_json | slice: 0, closing_index
    capture aggregate_rating_json
      echo '"aggregateRating":{"@type":"AggregateRating","ratingValue":'
      echo rating.rating | json
      echo ',"bestRating":'
      echo rating.scale_max | json
      echo ',"worstRating":'
      echo rating.scale_min | json
      echo ',"reviewCount":'
      echo rating_count | json
      echo '}}'
    endcapture
    assign structured_data_json = structured_data_json | append: ',' | append: aggregate_rating_json
  endif
-%}
{%- if product.price_max > 0 -%}
  <script type="application/ld+json">
    {{ structured_data_json }}
  </script>
{%- endif -%}
