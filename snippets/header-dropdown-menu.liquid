{% comment %}
  Renders a standard dropdown style menu for the header (two levels).
  Lists open on hover, and on click / Enter via <header-dropdown-menu> in sections/header.liquid.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<header-dropdown-menu>
  <nav class="header__inline-menu" aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="list-menu list-menu--inline" role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          {%- if link.links != blank -%}
            <div class="header__menu-details">
              <button
                type="button"
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset{% if link.child_active %} header__menu-item--active{% endif %}"
                aria-expanded="false"
                aria-controls="HeaderMenu-MenuList-{{ forloop.index }}"
                {% if link.child_active %}
                  aria-current="true"
                {% endif %}
              >
                <span>{{ link.title | escape }}</span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </button>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
              >
                {%- for childlink in link.links -%}
                  <li>
                    <a
                      id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ forloop.index }}"
                      href="{{ childlink.url }}"
                      class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                      {% if childlink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ childlink.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            <a
              id="HeaderMenu-{{ link.handle }}"
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link link--text focus-inset{% if link.current %} header__menu-item--active{% endif %}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              <span>{{ link.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header-dropdown-menu>
