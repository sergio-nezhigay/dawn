{%- doc -%}
  "Not sure which one fits?" strip across the product grid of the charger adapters collection (after the first full
  row), or a centred card instead of an empty result. The button opens the plug-size guide and focuses its model
  helper (assets/charger-finder.js; without JS it jumps to #adapter-help). Styles live in
  assets/section-charger-finder.css, loaded by sections/charger-adapter-finder.liquid.

  @param {boolean} [no_results] - Shown instead of an empty result (not named "empty": that is a Liquid literal): "nothing found" wording, centred card
  @param {string} [reset_url] - Link that clears the filters (with no_results)
{%- enddoc -%}
<div class="charger-help-card{% if no_results %} charger-help-card--empty{% endif %}">
  {%- comment -%} A charger label: where the plug size is printed {%- endcomment -%}
  <div class="charger-help-card__label" aria-hidden="true">
    <span>OUTPUT <mark>19V &#9107; 3.42A</mark></span>
    <span>PLUG <mark>5.5&times;2.5</mark></span>
  </div>
  <div class="charger-help-card__body">
    {%- if no_results -%}
      <p class="charger-help-card__title">{{ 'sections.charger_finder.empty_title' | t }}</p>
    {%- else -%}
      <p class="charger-help-card__title">{{ 'sections.charger_finder.card_title' | t }}</p>
    {%- endif -%}
    <p class="charger-help-card__text">{{ 'sections.charger_finder.card_text' | t }}</p>
  </div>
  <div class="charger-help-card__actions">
    <a class="charger-help-card__btn" href="#adapter-help" data-charger-help>
      {{- 'sections.charger_finder.card_button' | t -}}
    </a>
    <a class="charger-help-card__tg" href="https://t.me/NSergiy" target="_blank" rel="noopener">
      {{- 'sections.charger_finder.card_telegram' | t -}}
    </a>
  </div>
  {%- if no_results and reset_url -%}
    <a class="charger-help-card__link" href="{{ reset_url }}">{{ 'sections.charger_finder.reset_filters' | t }}</a>
  {%- endif -%}
</div>
