{%- comment -%}
  Product card used everywhere (homepage, collection, search, product-page rails, recently viewed):
  image (second image on hover, desktop), title, review stars, price (+ old price), optional Buy button.
  The whole card is a link (stretched title link); the Buy button sits above it.
  Buy adds single-variant products to the cart drawer (Dawn product-form); other products link to the product page.
  Sold-out products show "Sold out" instead of the price (never a 0 price) and a Details link instead of Buy.
  Styles live in assets/component-product-card.css.

  Accepts:
  - product: {Object} Product Liquid object
  - section_id: {String} ID of the section that renders the card
  - buy: {Boolean} Show the Buy / Details button (homepage). Default: false
  - lazy_load: {Boolean} Lazy-load the main image. Default: true
  - fetch_priority: {String} fetchpriority of the main image (e.g. 'high' for the first cards). Optional

  Usage:
  {% render 'product-card', product: product, section_id: section.id, buy: true %}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'ProductCard-' | append: section_id | append: '-' | append: product.id
  assign quick_buy = false
  if buy and product.available and product.has_only_default_variant and variant.quantity_rule.min <= 1 and variant.quantity_rule.increment <= 1
    assign quick_buy = true
  endif
  assign loading = 'lazy'
  if lazy_load == false
    assign loading = 'eager'
  endif
  assign sizes = '(min-width: 990px) 240px, (min-width: 750px) 30vw, 45vw'
  assign second = product.media[1]
  if second.media_type != 'image'
    assign second = nil
  endif
-%}
<div class="product-card{% if second %} product-card--second{% endif %}" data-handle="{{ product.handle }}">
  <div class="product-card__image">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 533
        | image_tag:
          widths: '165, 330, 533',
          sizes: sizes,
          loading: loading,
          fetchpriority: fetch_priority,
          alt: ''
      }}
      {%- if second -%}
        {{
          second
          | image_url: width: 533
          | image_tag: widths: '165, 330, 533', sizes: sizes, loading: 'lazy', alt: '', class: 'product-card__second'
        }}
      {%- endif -%}
    {%- endif -%}
  </div>
  <a class="product-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
  {% render 'review-badge', product: product %}
  <div class="product-card__row">
    {%- if product.available -%}
      {%- comment -%} The shop's money format has no symbol; append it like snippets/price.liquid {%- endcomment -%}
      {%- capture price -%}{{ product.price | money_without_currency }}&nbsp;{{ cart.currency.symbol }}{%- endcapture -%}
      <span class="product-card__price">
        {%- if product.price_varies -%}
          {{ 'products.product.price.from_price_html' | t: price: price }}
        {%- else -%}
          {{ price }}
        {%- endif -%}
        {%- if variant.compare_at_price > variant.price and product.price_varies == false -%}
          <s class="product-card__old">
            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
            {{- variant.compare_at_price | money_without_currency }}&nbsp;{{ cart.currency.symbol -}}
          </s>
        {%- endif -%}
      </span>
    {%- else -%}
      <span class="product-card__sold">{{ 'products.product.inventory_out_of_stock' | t }}</span>
    {%- endif -%}
    {%- if quick_buy -%}
      <product-form data-section-id="{{ section_id }}" data-hide-errors="true">
        {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" name="add" class="home-btn home-btn--buy product-card__buy">
            <span>{{ 'products.product.buy' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- elsif buy and product.available -%}
      <a class="home-btn home-btn--buy product-card__buy" href="{{ product.url }}" tabindex="-1">
        {{- 'products.product.buy' | t -}}
      </a>
    {%- elsif buy -%}
      <a class="home-btn home-btn--ghost product-card__buy" href="{{ product.url }}" tabindex="-1">
        {{- 'products.product.details' | t -}}
      </a>
    {%- endif -%}
  </div>
</div>
