{%- comment -%}
  "See also" chip row from a list.collection_reference metafield. Self-hides when blank.
  With 3+ links, the whole words every title starts with are dropped from the labels
  ("RAM SODIMM DDR4 8 GB" -> "SODIMM DDR4 8 GB"); each label keeps text and the
  full title goes in title="".

  Accepts:
  - related_collections: array of collection objects to link to
{%- endcomment -%}

{%- if related_collections != blank -%}
  {%- liquid
    assign prefix_length = 0
    if related_collections.size >= 3
      # .first is empty on a metafield list, so read the first title with a loop
      for rc in related_collections limit: 1
        assign first_words = rc.title | split: ' '
      endfor
      assign candidate = ''
      for word in first_words
        assign candidate = candidate | append: word | append: ' '
        for rc in related_collections
          assign rc_head = rc.title | slice: 0, candidate.size
          if rc_head != candidate or rc.title.size <= candidate.size
            assign candidate = ''
            break
          endif
        endfor
        if candidate == ''
          break
        endif
        assign prefix_length = candidate.size
      endfor
    endif
  -%}
  <div class="collection-related-links">
    <h2 class="collection-related-links__heading">{{ 'sections.collection_template.see_also' | t }}</h2>
    <div class="collection-related-links__row">
      {%- for related in related_collections -%}
        <a
          href="{{ related.url }}"
          class="collection-related-links__tag"
          {% if prefix_length > 0 %}
            title="{{ related.title | escape }}"
          {% endif %}
        >
          {{- related.title | slice: prefix_length, related.title.size -}}
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
