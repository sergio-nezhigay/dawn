
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .bg-transparent{
    background-color: transparent !important;
  }
  .section-{{ section.id }}-padding {
    padding-top: 27px;
    padding-bottom: 27px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 36px;
      padding-bottom: 36px;
    }
  }
{%- endstyle -%}

{%- if section.settings.products_source == 'recommendations' -%}
  {%- if recommendations.performed == false or recommendations.products_count > 0 -%}
    <div class="color-{{ section.settings.color_scheme }} gradient bg-transparent">
      <product-recommendations
        class="related-products {{ section.settings.container_width }} section-{{ section.id }}-padding isolate"
        data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent={{ section.settings.recommendations_intent }}"
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
      >
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <h2 class="section-title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
          <ul
            class="grid product-grid grid--6-col-desktop grid--2-col-tablet-down"
            role="list"
          >
            {%- assign skip_card_product_styles = false -%}
            {%- for recommendation in recommendations.products -%}
              <li class="grid__item">
                {%- render 'card-product',
                  card_product: recommendation,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: 'default',
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles
                -%}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </product-recommendations>
    </div>
  {%- endif -%}
{%- elsif section.settings.products_source == 'collection' -%}
  {%- assign collection = section.settings.collection -%}
  {%- if collection != blank and collection.products_count > 0 -%}
    <div class="color-{{ section.settings.color_scheme }} gradient bg-transparent">
      <div class="related-products {{ section.settings.container_width }} section-{{ section.id }}-padding isolate">
        <h2 class="section-title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
        <ul
          class="grid product-grid grid--6-col-desktop grid--2-col-tablet-down"
          role="list"
        >
          {%- assign skip_card_product_styles = false -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <li class="grid__item">
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: false,
                skip_styles: skip_card_product_styles
              -%}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product Suggestions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows related or complementary recommendations, or products from a collection."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "You may also like",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "page-width",
          "label": "Standard"
        },
        {
          "value": "page-width-narrow",
          "label": "Narrow"
        }
      ],
      "default": "page-width-narrow"
    },
    {
      "type": "select",
      "id": "products_source",
      "label": "Products source",
      "options": [
        {
          "value": "recommendations",
          "label": "Recommendations (upsells/similar)"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ],
      "default": "recommendations"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when Products source is set to \"Collection\""
    },
    {
      "type": "select",
      "id": "recommendations_intent",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products"
        }
      ],
      "default": "related",
      "label": "Recommendations intent",
      "info": "Used when Products source is set to \"Recommendations\""
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 18,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show secondary image on hover"
    }
  ],
  "presets": [
    {
      "name": "Product Suggestions"
    }
  ]
}
{% endschema %}
