<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-info-block.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-description-toggle.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  {%- assign description_text = product.description | strip_html | replace: '&nbsp;', ' ' | strip_newlines | strip -%}
  {%- assign show_wide_description = false -%}
  {%- if description_text.size >= section.settings.desktop_description_threshold -%}
    {%- assign show_wide_description = true -%}
  {%- endif -%}

  {%- capture product_barcode_supplier_info -%}
    <div class="flex justify-between items-center" style="margin-top: 2rem;">
      <span>
        {{- 'products.product.barcode_label' | t }}:<span class="uppercase">
          {{ product.selected_or_first_available_variant.barcode -}}
        </span>
      </span>
      <span class="opacity-30 border rounded-full p-1 text-base">
        {{ product.selected_or_first_available_variant.sku | split: '^' | last -}}
      </span>
    </div>
  {%- endcapture -%}

  <div class="page-width-narrow">
    {% render 'breadcrumbs' %}
    <div
      class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}"
      data-delta="{{ product.metafields.custom.delta | escape }}"
    >
      {%- liquid
        # Share: at the right of the review-stars row when the product has reviews; otherwise on the
        # photo's top-right corner (mirroring the zoom icon), so it never needs a line of its own.
        # Disabled blocks are absent from section.blocks, so the editor's Share toggle controls it.
        assign share_block = section.blocks | where: 'type', 'share' | first
        assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
        assign has_reviews = false
        if product.metafields.reviews.rating_count.value > 0
          assign has_reviews = true
        endif
        assign has_rating_badge = false
        for b in section.blocks
          if b.type == '@app' and b.id contains 'preview_badge'
            assign has_rating_badge = true
          endif
        endfor
        assign share_on_rating_row = false
        assign share_on_photo = false
        if share_block
          if has_rating_badge and has_reviews
            assign share_on_rating_row = true
          elsif product.media.size > 0
            assign share_on_photo = true
          endif
        endif
      -%}
      <div class="grid__item product__media-wrapper">
        {%- liquid
          assign media_share = blank
          if share_on_photo
            capture media_share
              render 'share-button', block: share_block, share_link: share_url
            endcapture
          endif
        -%}
        {% render 'product-media-gallery', variant_images: variant_images, corner_html: media_share %}
      </div>
      <div class="product__info-wrapper grid__item {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {%- if block.id contains 'preview_badge' -%}
                  {% comment %} Without reviews the badge is empty; its wrapper only keeps a small title-to-photo gap. {% endcomment %}
                  <div class="product__rating-row{% unless has_reviews %} product__rating-row--no-reviews{% endunless %}">
                    {% render block %}
                    {%- if share_on_rating_row -%}
                      {%- render 'share-button', block: share_block, share_link: share_url -%}
                    {%- endif -%}
                  </div>
                {%- else -%}
                  {% render block %}
                {%- endif -%}
              {%- when 'title' -%}
                <div class="product__title " {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1 ">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                  {%- unless product.available -%}
                    {%- render 'memory-alternatives', product: product, section_id: section.id, layout: 'jump' -%}
                  {%- endunless -%}
                </div>
              {%- when 'price' -%}
                <div class="product-info-block" {{ block.shopify_attributes }}>
                  {%- comment -%} Row 1: Price + SKU (Horizontal) {%- endcomment -%}
                  <div class="product-info-block__price-row">
                    <div id="price-{{ section.id }}" role="status" class="product-info-block__price">
                      {%- comment -%} Sold-out products left at price 0 show no price (reads as broken/free) {%- endcomment -%}
                      {%- unless product.available == false and product.price_max == 0 -%}
                        {%- render 'price',
                          product: product,
                          use_variant: true,
                          show_badges: false,
                          price_class: 'price--large'
                        -%}
                      {%- endunless -%}
                    </div>

                    {%- comment -%} SKU / Article Number (Right Side) {%- endcomment -%}
                    <p
                      class="product-info-block__sku{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                      id="Sku-{{ section.id }}"
                      role="status"
                    >
                      <span>{{ 'products.product.sku' | t }}:</span>
                      {{ product.selected_or_first_available_variant.sku | split: '^' | first }}
                    </p>
                  </div>

                  {%- comment -%} Row 2: Badge, Availability {%- endcomment -%}
                  <div class="product-info-block__details">
                    {%- comment -%} Super Price Badge (Conditional) {%- endcomment -%}
                    {%- assign compare_price = product.selected_or_first_available_variant.compare_at_price -%}
                    {%- assign current_price = product.selected_or_first_available_variant.price -%}
                    {%- if compare_price > current_price -%}
                      <span class="badge-super-price">СУПЕР ЦІНА</span>
                    {%- endif -%}

                    {%- comment -%} Inventory Status {%- endcomment -%}
                    <p
                      class="product-info-block__inventory{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}{% unless product.available %} product-info-block__inventory--sold-out{% endunless %}"
                      id="Inventory-{{ section.id }}"
                      role="status"
                    >
                      {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                        {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                          {%- if product.selected_or_first_available_variant.inventory_quantity <= 10 -%}
                            <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_low_stock' | t -}}
                          {%- else -%}
                            <span class="svg-wrapper" style="color: #16a34a">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_in_stock' | t -}}
                          {%- endif -%}
                        {%- else -%}
                          {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                            <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                          {%- else -%}
                            <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_out_of_stock' | t -}}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                    </p>
                  </div>

                  {%- assign dispatch_id = 'Dispatch-' | append: section.id -%}
                  {%- render 'product-dispatch-line',
                    variant: product.selected_or_first_available_variant,
                    id: dispatch_id
                  -%}

                  {%- comment -%} Volume Pricing Note {%- endcomment -%}
                  {%- if product.quantity_price_breaks_configured? -%}
                    <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                      <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                    </div>
                  {%- endif -%}

                  {%- unless product.available -%}
                    {%- render 'memory-alternatives', product: product, section_id: section.id -%}
                  {%- endunless -%}
                </div>

                {%- comment -%} Share Button removed from here - moved to buy_buttons row {%- endcomment -%}
              {%- when 'inventory' -%}
                {%- comment -%}
                  DEPRECATED: Inventory and SKU are now integrated into the 'price' block above
                  This block is maintained for backward compatibility but should be removed from theme customizer
                {%- endcomment -%}

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div
                    class="product__description rte quick-add-hidden{% if show_wide_description %} product__description--desktop-hidden{% else %} product__description--desktop-visible{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <h2 class="description__headings">
                      {{ 'products.product.description' | t }}
                    </h2>
                    <product-description-toggle
                      class="product__description-container product__description-disclosure"
                      id="ProductDescription-{{ section.id }}"
                    >
                      <div class="description__text product__description-content">
                        {{ product.description }}
                        {{ product_barcode_supplier_info }}
                      </div>
                      <button
                        type="button"
                        class="link product__description-toggle"
                        aria-expanded="false"
                        aria-controls="ProductDescription-{{ section.id }}"
                        data-label-more="{{ 'products.product.description_read_more' | t | escape }}"
                        data-label-less="{{ 'products.product.description_read_less' | t | escape }}"
                      >
                        {{ 'products.product.description_read_more' | t }}
                      </button>
                    </product-description-toggle>
                  </div>
                {%- endif -%}

              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span>{{ 'products.product.sku' | t }}:</span>
                  {{ product.selected_or_first_available_variant.sku | split: '^' | first }}
                </p>
              {%- when 'share' -%}
                {%- comment -%} Normally on the rating row or the photo corner (above); here only for products with no media and no reviews row. {%- endcomment -%}
                {%- unless share_on_rating_row or share_on_photo -%}
                  {%- render 'share-button', block: block, share_link: share_url -%}
                {%- endunless -%}

              {%- when 'variant_picker' -%}
                {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
              {%- when 'buy_buttons' -%}
                {% comment %} {% render 'my-first-ajax' %} {% endcomment %}
                <div class="product-form__row">
                  {%- if product.available -%}
                    {%- render 'buy-buttons',
                      block: block,
                      product: product,
                      product_form_id: product_form_id,
                      section_id: section.id,
                      show_pickup_availability: true
                    -%}
                  {%- else -%}
                    {%- render 'sold-out-contact', product: product -%}
                  {%- endif -%}
                </div>
                {% render 'product-features' %}
              {%- when 'complementary' -%}
                <product-recommendations
                  class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                  data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}"
                >
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <aside
                      aria-label="{{ 'accessibility.complementary_products' | t }}"
                      {{ block.shopify_attributes -}}
                      {% if block.settings.make_collapsible_row %}
                        class="product__accordion accordion"
                      {% endif %}
                    >
                      <div class="complementary-products__container">
                        {%- if block.settings.make_collapsible_row -%}
                          <details id="Details-{{ block.id }}-{{ section.id }}" open>
                            <summary>
                        {%- endif %}
                        <div class="summary__title">
                          {%- if block.settings.make_collapsible_row -%}
                            {% render 'icon-accordion', icon: block.settings.icon %}
                            <h2 class="h4 accordion__title">{{ 'products.product.may_be_interested' | t }}</h2>
                          {%- else -%}
                            <h2 class="h3 accordion__title">{{ 'products.product.may_be_interested' | t }}</h2>
                            {% comment %}<h2 class="h3 accordion__title">{{ block.settings.block_heading | t }}</h2>{% endcomment %}
                          {%- endif -%}
                        </div>
                        {%- if block.settings.make_collapsible_row -%}
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                          </summary>
                        {%- endif -%}
                        <slideshow-component class="slider-mobile-gutter">
                          {%- assign number_of_slides = recommendations.products_count
                            | plus: 0.0
                            | divided_by: block.settings.products_per_page
                            | ceil
                          -%}
                          <div
                            id="Slider-{{ block.id }}"
                            class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                            role="list"
                            {% if number_of_slides > 1 %}
                              aria-label="{{ 'general.slider.name' | t }}"
                            {% endif %}
                          >
                            {% assign skip_card_product_styles = false %}
                            {%- for i in (1..number_of_slides) -%}
                              <div
                                id="Slide-{{ block.id }}-{{ forloop.index }}"
                                class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                tabindex="-1"
                                role="group"
                                {% if number_of_slides > 1 %}
                                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                {% endif %}
                              >
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products
                                    limit: block.settings.products_per_page
                                    offset: continue
                                  -%}
                                    <li>
                                      {%- if block.settings.enable_quick_add -%}
                                        {% assign quick_add = 'standard' %}
                                      {%- else -%}
                                        {% assign quick_add = 'none' %}
                                      {%- endif -%}
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        skip_styles: skip_card_product_styles,
                                        quick_add: quick_add,
                                        section_id: section.id,
                                        horizontal_class: true,
                                        horizontal_quick_add: true
                                      %}
                                    </li>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons">
                              <button
                                type="button"
                                class="slider-button slider-button--prev"
                                name="previous"
                                aria-label="{{ 'general.slider.previous_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span>
                                  <span aria-hidden="true"> / </span>
                                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                  <span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button
                                        class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                        aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                        aria-controls="Slider-{{ block.id }}"
                                      >
                                        {%- if block.settings.pagination_style == 'numbers' -%}
                                          {{ forloop.index -}}
                                        {%- else -%}
                                          <span class="dot"></span>
                                        {%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button
                                type="button"
                                class="slider-button slider-button--next"
                                name="next"
                                aria-label="{{ 'general.slider.next_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}
                          </details>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>
            {%- endcase -%}
          {%- endfor -%}
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </section>
      </div>
    </div>

    {%- if product.description != blank and show_wide_description -%}
      <div class="product__wide-description">
        <div class="product__wide-description-card product__wide-description-card--split">

          {%- comment %} LEFT: description text {%- endcomment %}
          <div class="product__wide-desc-content rte">
            <h2>{{ 'products.product.description' | t }}</h2>
            <product-description-toggle class="product__description-disclosure">
              <div class="product__wide-description-body" id="WideDescription-{{ section.id }}">
                {{ product.description }}
                {{ product_barcode_supplier_info }}
              </div>
              <button
                type="button"
                class="link product__description-toggle product__wide-description-toggle"
                aria-expanded="false"
                aria-controls="WideDescription-{{ section.id }}"
                data-label-more="{{ 'products.product.description_read_more' | t | escape }}"
                data-label-less="{{ 'products.product.description_read_less' | t | escape }}"
              >
                {{ 'products.product.description_read_more' | t }}
              </button>
            </product-description-toggle>
          </div>

          {%- comment %} RIGHT: sticky sidebar — compact, NOT a copy of the hero {%- endcomment %}
          <div class="product__wide-desc-sidebar">

            <div id="price-sidebar-{{ section.id }}" role="status">
              {%- render 'price',
                product: product,
                use_variant: true,
                show_badges: false,
                price_class: 'price--large'
              -%}
            </div>

            <p class="product-info-block__inventory product__wide-desc-sidebar__availability">
              {%- assign _v = product.selected_or_first_available_variant -%}
              {%- if _v.inventory_management == 'shopify' -%}
                {%- if _v.inventory_quantity > 0 -%}
                  {%- if _v.inventory_quantity <= 10 -%}
                    <span class="svg-wrapper" style="color: rgb(238,148,65)">
                      {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                    </span>
                    {{- 'products.product.inventory_low_stock' | t -}}
                  {%- else -%}
                    <span class="svg-wrapper" style="color: #16a34a">
                      {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                    </span>
                    {{- 'products.product.inventory_in_stock' | t -}}
                  {%- endif -%}
                {%- else -%}
                  {%- if _v.inventory_policy == 'continue' -%}
                    <span class="svg-wrapper" style="color: rgb(62,214,96)">
                      {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                    </span>
                    {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                  {%- else -%}
                    <span class="svg-wrapper" style="color: rgb(200,200,200)">
                      {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                    </span>
                    {{- 'products.product.inventory_out_of_stock' | t -}}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            </p>
            {%- render 'product-dispatch-line', variant: _v -%}

            {%- assign sidebar_form_id = product_form_id | append: '-sidebar' -%}
            {% comment %} <product-form> submits via AJAX and opens the cart drawer; a bare form redirects to /cart. {% endcomment %}
            <product-form data-section-id="{{ section.id }}">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                <span class="product-form__error-message"></span>
              </div>
              {%- form 'product', product,
                id: sidebar_form_id,
                class: 'product-form product-form--sidebar',
                novalidate: 'novalidate'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                  data-product-form-id="{{ sidebar_form_id }}"
                >
                <button
                  id="ProductSubmitButton-{{ section.id }}-sidebar"
                  type="submit"
                  class="product-form__submit button button--full-width button--primary"
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                >
                  <span>
                    {%- if product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.buy' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>

          </div>
        </div>
      </div>
      {%- if show_wide_description -%}
        <script>
          (function () {
            var heroBtn = document.getElementById('ProductSubmitButton-{{ section.id }}');
            var sidebar = document.querySelector('#shopify-section-{{ section.id }} .product__wide-desc-sidebar');
            if (!heroBtn || !sidebar) return;
            new IntersectionObserver(function (entries) {
              sidebar.classList.toggle('is-visible', !entries[0].isIntersecting);
            }, { threshold: 0 }).observe(heroBtn);
          })();
        </script>
      {%- endif -%}
    {%- endif -%}

    {% render 'product-media-modal', variant_images: variant_images %}


    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    {%- render 'product-structured-data', product: product -%}
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        function addCartAttribute(attributeKey, attributeValue) {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({
              attributes: {
                [attributeKey]: attributeValue,
              },
            }),
          })
            .then((response) => response.json())
            .then((data) => {
              console.log('Cart attributes updated:', data);
            })
            .catch((error) => {
              console.error('Error:', error);
            });
        }

        document.querySelector('.product-form__submit').addEventListener('click', function () {
          const productEl = document.querySelector('.product');
          const metaDelta = productEl.dataset.delta;
          console.log('metaDelta', JSON.stringify(metaDelta, null, 2));

          if (!!metaDelta) {
            addCartAttribute('delta', metaDelta);
          }
        });
      });
    </script>
  </div>
  <script src="{{ 'product-price-update.js' | asset_url }}" defer></script>
</product-info>

