{%- comment -%}
  Title for policy pages. The policy text itself is the admin policy (Settings > Policies),
  rendered by Shopify in content_for_layout right after this section; it is the only copy
  of the text, so the page, Google and AI shopping agents all read the same thing.
  Shipping and refund texts follow a fixed shape and get the sheet layout (policy-head--sheet).
{%- endcomment -%}
{{ 'section-main-policy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sheet = true
  if request.path contains 'shipping-policy'
    assign policy_heading = 'sections.main_policy.shipping_policy_title' | t
  elsif request.path contains 'refund-policy'
    assign policy_heading = 'sections.main_policy.refund_policy_title' | t
  else
    assign sheet = false
    assign policy_heading = page_title
  endif
-%}

<div class="policy-head{% if sheet %} policy-head--sheet{% endif %}">
  <h1 class="ui-heading ui-heading--h1">{{ policy_heading }}</h1>
</div>

{% schema %}
{
  "name": "Main Policy",
  "tag": "section",
  "class": "section"
}
{% endschema %}
